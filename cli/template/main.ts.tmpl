/// <reference path="./voussoir.d.ts" />

const result = document.getElementById("result")!;
const form = document.getElementById("greet") as HTMLFormElement;
const nameInput = document.getElementById("name") as HTMLInputElement;
const slowButton = document.getElementById("slow") as HTMLButtonElement;
// The shell's accessibility surface arrived in shim protocol 4; an older shell has
// no `a11y` at all, so this is the guard the documentation tells you to use.
const canAnnounce = window.voussoir.protocol >= 4;
const settingsButton = document.getElementById("settings") as HTMLButtonElement;

function show(text: string) {
  // The result region is `role="status" aria-live="polite"`, so replacing its text
  // is what makes the answer audible. No separate announcement: two live regions
  // for one change is how a screen reader ends up saying everything twice.
  result.textContent = text;
}

form.addEventListener("submit", async (event) => {
  event.preventDefault();
  show("invoking...");
  try {
    show(await window.voussoir.invoke<string>("greet", { name: nameInput.value }));
  } catch (error) {
    show("error: " + (error as Error).message);
  }
});

// An async command: the window stays responsive while this runs.
slowButton.addEventListener("click", async () => {
  slowButton.disabled = true;
  show("working off the UI thread...");
  try {
    const reply = await window.voussoir.invoke<{ slept_ms: number }>("slow_task", { ms: 800 });
    show(`async command finished after ${reply.slept_ms} ms`);
  } catch (error) {
    show("error: " + (error as Error).message);
  } finally {
    slowButton.disabled = false;
    // No element on screen says "the background work is over", so tell the
    // reader directly rather than relying on a button label changing.
    if (canAnnounce) window.voussoir.a11y.announce("async task finished");
  }
});

// A second window is a desktop capability. Rather than offer a button that errors
// on Android, hide it: the page is shared, the affordances are not.
if (window.voussoir.platform === "android" || window.voussoir.platform === "ios") {
  settingsButton.hidden = true;
} else {
  settingsButton.addEventListener("click", () => {
    window.voussoir.invoke("open_settings").catch((error) => show("error: " + error.message));
  });
}

// Settings survive a restart because `storage.set` writes a JSON file in the
// platform data directory. No crate, no path handling: the shell owns both.
settingsButton.addEventListener("dblclick", async () => {
  await window.voussoir.invoke("storage.set", { key: "settings.opened", value: Date.now() });
  const saved = await window.voussoir.invoke<number | null>("storage.get", { key: "settings.opened" });
  show(`settings last opened at ${saved ?? "never"}`);
});

// A change the user cannot see — a background task finished, settings saved — is
// what `announce` is for. The result region above speaks on its own; this covers
// the case where there is no element to update.
// Menu clicks arrive as events, so a native menu needs no extra wiring here.
window.voussoir.listen<{ id: string }>("menu", (event) => show(`menu: ${event.id}`));

// Lifecycle is reported, not interpreted: a web page has no state machine to
// run, but knowing it was paused is what tells it to stop a timer. On Android
// this is the only signal that the activity left the foreground; on desktop the
// same event fires for a window that loses or regains focus.
window.voussoir.listen<{ state: string }>("lifecycle", ({ state }) => {
  if (state === "resume") return;
  show(`lifecycle: ${state}`);
});

// Respect the reader's motion setting in one place. The stylesheet already turns
// transitions off; this is for anything scripted, and the shim exposes the value
// because a page drawing to a `<canvas>` has no media query to consult.
const motion = window.voussoir.a11y?.prefers() ?? { reducedMotion: false };

form.requestSubmit();
