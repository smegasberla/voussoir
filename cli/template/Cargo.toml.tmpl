[package]
name = "{{CRATE}}"
version = "0.1.0"
edition = "2021"

[dependencies]
# `full` turns on the native menu bar, file dialogs and update checks. `storage`
# adds the JSON-file key/value store the page reaches as
# `storage.get|set|delete|keys|path`. Drop either to slim the shell; add `rt` when
# you want `async fn` commands on a shared runtime, and `devtools` only if you
# want F12 in a build that is not `voussoir dev`.
voussoir = { {{VOUSSOIR_PATH_INNER}}, features = ["full", "storage"] }
# The command table. Release links it statically; `voussoir dev` additionally
# builds it as a cdylib and hot-swaps it into the running shell.
commands = { path = "commands", package = "{{CRATE}}-commands" }

[features]
# Enabled only by `voussoir dev`. Release builds never enable it, which is what
# keeps libloading (the hot-reload loader) out of every shipped binary.
hot-reload = ["voussoir/hot-reload"]
# `voussoir dev` asks for this together with `hot-reload`: the inspector is a
# development tool, and keeping it a feature is what keeps it out of a
# release build that never opts in.
devtools = ["voussoir/devtools"]

[workspace]
members = ["commands"]

[profile.release]
opt-level = "s"
lto = true
codegen-units = 1
strip = true
