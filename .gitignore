# Agent / editor local state. Never committed, in any subdirectory.
.crush/
**/.crush/
.crush
**/.crush

target/
node_modules/
dist/
.DS_Store
*.swp
dist-package/
*.AppImage
voussoir-android/example/target/
voussoir-android/example/app/build/
voussoir-android/example/app/.gradle/
voussoir-android/example/app/src/main/java/com/voussoir/example/*.kt
voussoir-android/example/app/src/main/java/com/voussoir/example/proguard-wry.pro
voussoir-android/example/app/src/main/jniLibs/

# Kotlin compiler scratch space, written on every Android build
**/.kotlin

# The website is its own private repository (smegasberla/voussoir-website).
# It is ignored rather than added as a submodule on purpose: this repository is
# public and that one is private, so a submodule would make `git clone
# --recursive` fail for everyone. Clone it beside this checkout instead.
/website/

# Generated site output, if the website is checked out into place.
/website/dist/

# The Relay app is its own public repository (smegasberla/relay).
# Ignored for the same reason as /website/: independent history and releases.
/relay/

# libFuzzer build output, the corpus it accumulates, and anything it finds.
# `fuzz/Cargo.lock` is committed on purpose: the harness pins `libfuzzer-sys`, and a
# lockfile is what makes a scheduled run reproducible when it reports a finding.
/fuzz/target/
/fuzz/corpus/
/fuzz/artifacts/

# Working bug-fix list; local only, never committed.
/FIXES.md

# Thumbnail output, and the TrueType copies resvg reads but woff2 it cannot.
/thumbnail/out/
/thumbnail/fonts/*.ttf
